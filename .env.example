# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://landretrieve:landretrieve_secret@localhost:5432/landretrieve_dev?schema=public"

# ─────────────────────────────────────────
# AUTH — JWT
# ─────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────
# AUTH — NEXT-AUTH
# ─────────────────────────────────────────
NEXTAUTH_SECRET="change-me-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (da configurare in Stripe Dashboard)
STRIPE_PRICE_AGENCY_BASE="price_..."    # €29.90/mese agenzia base
STRIPE_PRICE_AGENCY_PRO="price_..."     # €59.90/mese agenzia pro
STRIPE_PRICE_AGENT_BASE="price_..."     # €29.90/mese agente base
STRIPE_PRICE_AGENT_PRO="price_..."      # €44.90/mese agente pro
STRIPE_PRICE_BADGE="price_..."          # €4.90/mese badge verificato
STRIPE_PRICE_FEATURED="price_..."       # €5.90/mese in evidenza

# ─────────────────────────────────────────
# CLOUDFLARE R2
# ─────────────────────────────────────────
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="landretrieve-media"
R2_PUBLIC_URL="https://media.landretrieve.com"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# ─────────────────────────────────────────
# GOOGLE MAPS
# ─────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY="AIzaSyCXU5OQRShbztd7a-A5_LFwmVkwOdaOYnk"

# ─────────────────────────────────────────
# EMAIL — RESEND
# ─────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@landretrieve.com"
EMAIL_REPLY_TO="info@landretrieve.com"

# ─────────────────────────────────────────
# ANALYTICS — POSTHOG
# ─────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─────────────────────────────────────────
# REDIS — UPSTASH (produzione) o locale (dev)
# ─────────────────────────────────────────
REDIS_URL="redis://:redis_secret@localhost:6379"
# Upstash produzione:
# REDIS_URL="rediss://:<password>@<host>.upstash.io:6380"

# ─────────────────────────────────────────
# IP DETECTION
# ─────────────────────────────────────────
IPAPI_URL="https://ipapi.co/json/"

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NODE_ENV="development"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
APP_URL="http://localhost:3000"
PORT="3001"
