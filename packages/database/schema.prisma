generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  AGENCY
  AGENT
  VISITOR
}

enum ListingType {
  SALE
  RENT
  AUCTION
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  EXPIRED
  SOLD
}

enum SubscriptionPlan {
  BASE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  TRIALING
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  email       String    @unique
  password    String
  role        UserRole  @default(VISITOR)
  firstName   String?
  lastName    String?
  displayName String?
  avatar      String?
  isVerified  Boolean   @default(false)
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agencyProfile   AgencyProfile?
  agentProfile    AgentProfile?
  properties      Property[]
  sentThreads     Thread[]        @relation("SentThreads")
  receivedThreads Thread[]        @relation("ReceivedThreads")
  messages        Message[]
  crmLeads        CrmLead[]
  savedProperties SavedProperty[]
  savedSearches   SavedSearch[]
  subscription    Subscription?
  reviews         Review[]

  @@index([email])
  @@index([username])
  @@index([role])
}

// ─── AGENCY PROFILE ──────────────────────────────────────────────────────────

model AgencyProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  name          String
  slug          String  @unique
  taxNumber     String?
  licenses      String?
  phone         String?
  mobile        String?
  fax           String?
  email         String?
  website       String?
  address       String?
  mapAddress    String?
  lat           Decimal?
  lng           Decimal?
  language      String?
  serviceArea   String?
  specialties   String?
  bio           String?
  logo          String?
  // Social
  facebook      String?
  instagram     String?
  linkedin      String?
  twitter       String?
  youtube       String?
  whatsapp      String?
  telegram      String?
  tiktok        String?
  pinterest     String?
  vimeo         String?
  skype         String?
  // Status
  isVerified    Boolean            @default(false)
  isVisible     Boolean            @default(true)
  // Stripe
  stripeCustomerId   String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents        AgentProfile[]
  properties    Property[]

  @@index([slug])
  @@index([isVerified])
}

// ─── AGENT PROFILE ───────────────────────────────────────────────────────────

model AgentProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  agencyId     String?
  slug         String  @unique
  position     String?
  companyName  String?
  license      String?
  taxNumber    String?
  mobile       String?
  officeNumber String?
  email        String?
  address      String?
  serviceArea  String?
  specialties  String?
  language     String?
  website      String?
  bio          String?
  // Social
  linkedin     String?
  skype        String?
  whatsapp     String?
  // Status
  isVerified    Boolean            @default(false)
  isVisible     Boolean            @default(true)
  displayOption String?            // 'agent_info' | 'agency_info'
  // Stripe
  stripeCustomerId   String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency       AgencyProfile? @relation(fields: [agencyId], references: [id])
  properties   Property[]

  @@index([slug])
  @@index([agencyId])
  @@index([isVerified])
}

// ─── PROPERTY ─────────────────────────────────────────────────────────────────

model Property {
  id               String         @id @default(cuid())
  propertyId       String?        @unique // LR00042
  title            String
  slug             String         @unique
  description      String?
  status           PropertyStatus @default(DRAFT)
  listingType      ListingType    @default(SALE)
  // Pricing
  price            Decimal?
  secondPrice      Decimal?
  currency         String         @default("EUR")
  pricePrefix      String?
  pricePostfix     String?
  pricePlaceholder String?
  showPricePH      Boolean        @default(false)
  // Size
  size             Decimal?
  sizeUnit         String         @default("m²")
  landSize         Decimal?
  // Rooms
  bedrooms         Int?
  bathrooms        Int?
  garages          Int?
  rooms            Int?
  yearBuilt        Int?
  // Location
  address          String?
  mapAddress       String?
  zipCode          String?
  city             String?
  area             String?
  country          String         @default("Italia")
  lat              Decimal?
  lng              Decimal?
  showStreetView   Boolean        @default(false)
  // Media
  videoUrl         String?
  videoThumb       String?
  virtualTourUrl   String?
  // Taxonomy
  propertyType     String?        // Ville | Casali | Agriturismi | Az.Agricole | Terreni
  propertyStatus   String?        // Vendita | Venduto | Nuovo
  labels           String[]       // Hot | Nuovo | Ridotto | In Evidenza
  // Energy
  energyClass      String?        // A4 → G
  energyGlobalIndex Decimal?
  // Relations
  agentId          String?
  agencyId         String?
  userId           String?
  agent            AgentProfile?  @relation(fields: [agentId], references: [id])
  agency           AgencyProfile? @relation(fields: [agencyId], references: [id])
  author           User?          @relation(fields: [userId], references: [id])
  images           PropertyImage[]
  features         PropertyFeature[]
  floorPlans       FloorPlan[]
  attachments      PropertyAttachment[]
  // Payment
  paymentStatus    String         @default("not_paid")
  isFeatured       Boolean        @default(false)
  neverExpire      Boolean        @default(false)
  expiresAt        DateTime?
  privateNote      String?
  // Relations CRM
  enquiries        CrmEnquiry[]
  deals            CrmDeal[]
  savedBy          SavedProperty[]
  insights         Insight[]
  reviews          Review[]
  // Timestamps
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  publishedAt      DateTime?

  @@index([slug])
  @@index([propertyId])
  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([country])
  @@index([city])
  @@index([isFeatured])
  @@index([agentId])
  @@index([agencyId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int      @default(0)
  alt        String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyFeature {
  id         String   @id @default(cuid())
  propertyId String
  feature    String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model FloorPlan {
  id          String   @id @default(cuid())
  propertyId  String
  title       String?
  price       Decimal?
  bathrooms   Int?
  rooms       Int?
  size        Decimal?
  description String?
  imageUrl    String?
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAttachment {
  id         String   @id @default(cuid())
  propertyId String
  name       String?
  url        String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model CrmLead {
  id          String   @id @default(cuid())
  userId      String
  prefix      String?
  firstName   String?
  lastName    String?
  displayName String?
  email       String
  mobile      String?
  homePhone   String?
  workPhone   String?
  address     String?
  city        String?
  state       String?
  country     String?
  source      String?
  status      String?  @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  notes       CrmNote[]
  deals       CrmDeal[]
  enquiries   CrmEnquiry[]
  activities  CrmActivity[]

  @@index([userId])
  @@index([email])
  @@index([status])
}

model CrmDeal {
  id              String    @id @default(cuid())
  userId          String
  title           String?
  listingId       String?
  leadId          String?
  agentId         String?
  agentType       String?
  status          String?   @default("open")
  nextAction      String?
  actionDueDate   DateTime?
  dealValue       Decimal?
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  property        Property?  @relation(fields: [listingId], references: [id])
  lead            CrmLead?   @relation(fields: [leadId], references: [id])
  notes           CrmNote[]

  @@index([userId])
  @@index([leadId])
  @@index([listingId])
  @@index([status])
}

model CrmEnquiry {
  id              String   @id @default(cuid())
  userId          String
  leadId          String?
  listingId       String?
  negotiator      String?
  source          String?
  status          String?  @default("new")
  enquiryTo       String?
  enquiryUserType String?
  message         String?
  enquiryType     String?
  meta            Json?
  privateNote     String?
  createdAt       DateTime @default(now())
  property        Property?  @relation(fields: [listingId], references: [id])
  lead            CrmLead?   @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

model CrmNote {
  id        String   @id @default(cuid())
  userId    String
  belongTo  String
  note      String?
  type      String?  // 'lead' | 'deal'
  createdAt DateTime @default(now())
  lead      CrmLead? @relation(fields: [belongTo], references: [id])
  deal      CrmDeal? @relation(fields: [belongTo], references: [id])

  @@index([belongTo])
  @@index([userId])
}

model CrmActivity {
  id        String   @id @default(cuid())
  userId    String
  leadId    String?
  meta      Json?
  createdAt DateTime @default(now())
  lead      CrmLead? @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([leadId])
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Thread {
  id              String    @id @default(cuid())
  senderId        String
  receiverId      String
  propertyId      String?
  seen            Boolean   @default(false)
  receiverDeleted Boolean   @default(false)
  senderDeleted   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  sender          User      @relation("SentThreads", fields: [senderId], references: [id])
  receiver        User      @relation("ReceivedThreads", fields: [receiverId], references: [id])
  messages        Message[]

  @@index([senderId])
  @@index([receiverId])
}

model Message {
  id              String   @id @default(cuid())
  threadId        String
  createdById     String
  message         String
  attachments     Json?
  receiverDeleted Boolean  @default(false)
  senderDeleted   Boolean  @default(false)
  createdAt       DateTime @default(now())
  thread          Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdById], references: [id])

  @@index([threadId])
  @@index([createdById])
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  stripeCustomerId  String?
  stripeSubId       String?
  plan              SubscriptionPlan
  status            SubscriptionStatus
  price             Decimal
  currency          String             @default("EUR")
  billingCycle      String             @default("monthly")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  invoices          Invoice[]

  @@index([userId])
  @@index([status])
  @@index([stripeSubId])
}

model Invoice {
  id              String       @id @default(cuid())
  subscriptionId  String
  stripeInvoiceId String?
  amount          Decimal
  currency        String       @default("EUR")
  status          String
  pdfUrl          String?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model FeaturedListing {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  stripeId   String?
  price      Decimal  @default(5.90)
  startDate  DateTime @default(now())
  endDate    DateTime
  isActive   Boolean  @default(true)

  @@index([propertyId])
  @@index([isActive])
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────

model Insight {
  id               String   @id @default(cuid())
  listingId        String
  time             DateTime @default(now())
  ipAddress        String?
  uniqueIdentifier String
  referralUrl      String?
  referralDomain   String?
  platform         String?
  device           String?
  browser          String?
  userAgent        String?
  language         String?
  countryCode      String?
  country          String?
  property         Property @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([time])
  @@index([countryCode])
}

// ─── REVIEWS ──────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  targetId   String
  targetType String   // 'property' | 'agent' | 'agency'
  authorId   String
  title      String
  body       String
  rating     Int
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  property   Property? @relation(fields: [targetId], references: [id])

  @@index([targetId])
  @@index([targetType])
  @@index([authorId])
  @@index([isApproved])
}

// ─── SAVED / SEARCHES ─────────────────────────────────────────────────────────

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CustomField {
  id            String  @id @default(cuid())
  label         String
  fieldId       String  @unique
  type          String  // text | select | multiselect | checkbox_list | radio | number | textarea
  options       Json?
  placeholder   String?
  isSearch      Boolean @default(false)
  searchCompare String?
}
