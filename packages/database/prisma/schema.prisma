generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  AGENT
  AGENCY
  ADMIN
}

enum PropertyCategory {
  VILLA
  CASALE
  AGRITURISMO
  AZIENDA_AGRICOLA
  TERRENO
  APPARTAMENTO
  ALTRO
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SOLD
  RENTED
}

enum CatasterType {
  TERRENI
  FABBRICATI
}

enum SubscriptionPlan {
  CONNECT
  SIGNATURE
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum MessageThreadStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  firstName      String
  lastName       String
  role           UserRole @default(BUYER)
  avatarUrl      String?
  phone          String?
  country        String?
  locale         String   @default("it")
  emailVerified  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  agencyId       String?
  agency         Agency?           @relation(fields: [agencyId], references: [id])
  agentProfile   AgentProfile?
  properties     Property[]
  subscription   Subscription?
  sentMessages   Message[]         @relation("MessageSender")
  threads        MessageThread[]   @relation("ThreadParticipants")
  offers         PropertyOffer[]   @relation("BuyerOffers")
  receivedOffers PropertyOffer[]   @relation("AgentOffers")
  favorites      Favorite[]
  savedSearches  SavedSearch[]
  requests       PropertyRequest[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  licenseNumber   String?
  yearsExperience Int?
  languages       String[]
  specializations String[]
  websiteUrl      String?
  linkedinUrl     String?
  reviewCount     Int      @default(0)
  averageRating   Decimal  @default(0) @db.Decimal(3, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("agent_profiles")
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  websiteUrl  String?
  phone       String?
  email       String?
  address     String?
  city        String?
  province    String?
  vatNumber   String?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agents     User[]
  properties Property[]

  @@map("agencies")
}

model Property {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @db.Text
  listingType ListingType
  category    PropertyCategory
  status      PropertyStatus   @default(DRAFT)

  // Pricing
  price       Decimal          @db.Decimal(12, 2)
  priceOnRequest Boolean       @default(false)
  rentDeposit Decimal?         @db.Decimal(12, 2)
  rentMonthly Decimal?         @db.Decimal(12, 2)

  // Location (NO "Toscana" in public text — use province/comune)
  region      String
  province    String
  comune      String
  address     String?
  latitude    Decimal?         @db.Decimal(10, 8)
  longitude   Decimal?         @db.Decimal(11, 8)

  // Dimensions
  surfaceSqm  Int?
  landHectares Decimal?        @db.Decimal(10, 4)
  bedrooms    Int?
  bathrooms   Int?
  floors      Int?
  buildYear   Int?

  // Catastral data
  catasterType      CatasterType?
  catasterProvincia String?
  catasterComune    String?
  catasterFoglio    String?
  catasterParticella String?
  catasterSub       String?

  // Features / amenities (stored as string array)
  features    String[]

  // Media
  images      PropertyImage[]
  mainImageUrl String?

  // SEO & i18n
  metaTitle       String?
  metaDescription String?

  // Visibility
  isFeatured      Boolean  @default(false)
  featuredUntil   DateTime?
  viewCount       Int      @default(0)

  // Relations
  agentId    String
  agent      User      @relation(fields: [agentId], references: [id])
  agencyId   String?
  agency     Agency?   @relation(fields: [agencyId], references: [id])
  threads    MessageThread[]
  offers     PropertyOffer[]
  favorites  Favorite[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url         String
  r2Key       String
  altText     String?
  order       Int      @default(0)
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  @@map("property_images")
}

model PropertyOffer {
  id          String      @id @default(cuid())
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  agentId     String
  agent       User        @relation("AgentOffers", fields: [agentId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  status      OfferStatus @default(PENDING)
  message     String?     @db.Text
  counterAmount Decimal?  @db.Decimal(12, 2)
  counterMessage String?  @db.Text
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("property_offers")
}

model PropertyRequest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  email       String
  firstName   String
  lastName    String
  phone       String?
  country     String?
  locale      String   @default("it")

  // What they're looking for
  listingType ListingType?
  category    PropertyCategory[]
  regions     String[]
  priceMin    Decimal?  @db.Decimal(12, 2)
  priceMax    Decimal?  @db.Decimal(12, 2)
  surfaceMin  Int?
  surfaceMax  Int?
  bedrooms    Int?
  message     String    @db.Text

  isHandled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("property_requests")
}

model MessageThread {
  id          String              @id @default(cuid())
  propertyId  String
  property    Property            @relation(fields: [propertyId], references: [id])
  status      MessageThreadStatus @default(OPEN)
  subject     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Participants
  participants User[]   @relation("ThreadParticipants")
  messages     Message[]

  @@map("message_threads")
}

model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("MessageSender", fields: [senderId], references: [id])
  content     String        @db.Text
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@map("messages")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  billingCycle    BillingCycle
  status          SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  stripePriceId        String?
  badgeAddon      Boolean            @default(false)
  featuredCount   Int                @default(0)
  totalPrice      Decimal            @db.Decimal(10, 2)
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("subscriptions")
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  filters     Json
  alertEmail  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("saved_searches")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("refresh_tokens")
}
